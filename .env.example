# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 git에 올라가지 않습니다. 키를 다른 곳(채팅, 메신저 등)에 붙여넣지 마세요.

# Google Maps Platform API 키 — 발급 방법은 docs/API_KEYS.md 참고
VITE_GOOGLE_MAPS_API_KEY=

# (선택) Google Cloud 콘솔에서 만든 지도 ID. 비워 두면 개발용 기본값(DEMO_MAP_ID)을 씁니다.
VITE_GOOGLE_MAP_ID=

# (선택) 한국 대중교통 — ODsay LAB 웹 키 (요금·환승 포함). 없으면 Google 대중교통을 씁니다.
VITE_ODSAY_API_KEY=

# (선택) 한국 도보 — TMAP(SK open API) 앱 키. 없으면 도보는 거리로 추정합니다.
VITE_TMAP_APP_KEY=

# (선택) 서버 — Supabase 프로젝트 주소와 anon(공개) 키. 설정 방법은 docs/SUPABASE_SETUP.md
# 비워 두면 로그인·저장한 여행·커뮤니티가 지금처럼 이 브라우저에만 저장됩니다.
# service_role 키는 절대 넣지 마세요 (브라우저에 그대로 노출됩니다).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
